{
  "manifest_version": 3,
  "name": "Twitch DVR (Test)",
  "version": "1.0",
  "description": "Rewind live Twitch streams, use dedicated 1x, 1.25x, 1.5x, 2x speed multipliers, quick-seek, and bypass login checks (Test Build)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "twitchrewind-test@fractal.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.twitch.tv/*",
    "https://twitch.tv/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Twitch DVR",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "js": [
        "content/content-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "js": [
        "content/gql-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "js": [
        "content/player-controls.js"
      ],
      "css": [
        "content/player-controls.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
